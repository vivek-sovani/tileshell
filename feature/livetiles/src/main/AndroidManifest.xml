<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Opt-in notification listener (FR-1.2 badges, FR-2 mail/messages
            faces). Declared in the live-tiles library so the service travels
            with the module; merges into the app manifest. The user must enable
            it under system "Notification access" (deep-linked from personalize);
            until then it never binds and every tile stays static / un-badged.
        -->
        <service
            android:name=".TileNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Home-screen widgets (S32 pilot + S33 rollout, plain RemoteViews —
            no Compose rendering). Each receiver must be exported=true: the
            update broadcast comes from the system/host launcher, a different
            package. Declared here so they merge into the app manifest like
            the notification listener above.
        -->
        <receiver
            android:name=".widget.WeatherAppWidgetProvider"
            android:exported="true"
            android:label="@string/weather_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BatteryAppWidgetProvider"
            android:exported="true"
            android:label="@string/battery_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Push-driven refresh on the moments a user actually looks at
                     this widget for — plugging in/out, crossing the low-battery
                     threshold — on top of the existing 15-min periodic backstop.
                     ACTION_BATTERY_CHANGED itself can't be added here: Android
                     never delivers it to a manifest-registered receiver, at any
                     API level, only to a dynamically registered one — see
                     BatteryAppWidgetProvider's own doc comment. -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.AlarmAppWidgetProvider"
            android:exported="true"
            android:label="@string/alarm_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- The next-alarm time is the widget's entire content, and this
                     broadcast fires exactly when it changes (alarm set, edited,
                     cancelled, or fired). Unlike ACTION_BATTERY_CHANGED it IS
                     delivered to a manifest-registered receiver, so this widget
                     can be event-driven and keep only a slow periodic backstop
                     instead of polling every 30 minutes. -->
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MoonPhaseAppWidgetProvider"
            android:exported="true"
            android:label="@string/moonphase_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/moonphase_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StepsAppWidgetProvider"
            android:exported="true"
            android:label="@string/steps_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/steps_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CalendarSystemAppWidgetProvider"
            android:exported="true"
            android:label="@string/calsys_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calsys_widget_info" />
        </receiver>

        <!-- Private receivers for the widget actions that mutate state. These
             are deliberately NOT AppWidgetProviders: a provider must be
             exported so the OS can deliver APPWIDGET_UPDATE, and an exported
             receiver is reachable by an explicit intent from any app, which
             previously let any installed app delete the user's tasks by
             guessing a sequential task id, or toggle the torch. A PendingIntent
             is dispatched with this app's own identity, so the widgets still
             reach these while nothing else can. See WidgetActionReceivers.kt. -->
        <receiver
            android:name=".widget.TaskWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.FlashlightWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.FlashlightAppWidgetProvider"
            android:exported="true"
            android:label="@string/flashlight_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/flashlight_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StockAppWidgetProvider"
            android:exported="true"
            android:label="@string/stock_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stock_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CommodityAppWidgetProvider"
            android:exported="true"
            android:label="@string/commodity_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/commodity_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.SportsAppWidgetProvider"
            android:exported="true"
            android:label="@string/sports_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sports_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TasksAppWidgetProvider"
            android:exported="true"
            android:label="@string/tasks_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NotesAppWidgetProvider"
            android:exported="true"
            android:label="@string/notes_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/notes_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.StickyNoteAppWidgetProvider"
            android:exported="true"
            android:label="@string/stickynote_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stickynote_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CountdownAppWidgetProvider"
            android:exported="true"
            android:label="@string/countdown_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <!--
            Shared per-widget colour-picker configure activity (every
            android:configure above points here) — see WidgetConfigureActivity's
            own doc comment for why one Activity serves every kind. Must be
            exported=true (launched by the system/host launcher's "add widget"
            flow) and declare the APPWIDGET_CONFIGURE intent-filter the OS
            requires of a configure activity.
        -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Standalone "manage this widget's content" screens for Tasks/Notes
            — not reachable via any OS-triggered intent-filter, only ever
            launched via an explicit-component PendingIntent TileShell itself
            creates (TasksAppWidgetProvider.managePendingIntent /
            NotesAppWidgetProvider.managePendingIntent), the same way
            reconfigurePendingIntent already launches WidgetConfigureActivity
            manually — so exported="false" is correct here (unlike that
            activity, nothing outside this app ever targets these directly).

            android:taskAffinity="" + excludeFromRecents on all three of these
            widget-editor activities (user-reported: backing out of one
            landed on TileShell's own Start screen instead of whatever host
            launcher — e.g. Samsung's — was actually showing underneath).
            Without an explicit affinity, an activity defaults to the app's
            package name — the same affinity MainActivity itself has — so
            Android could resolve "what's on top of this task now" back onto
            a lingering MainActivity task sharing that affinity, instead of
            truly revealing the host launcher's own separate task. A blank
            affinity keeps each of these in its own isolated task, so
            finishing one always uncovers whatever was really in the
            foreground before it launched.
        -->
        <activity
            android:name=".widget.TaskListWidgetActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".widget.NotesWidgetActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    </application>

</manifest>
