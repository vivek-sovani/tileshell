<?xml version="1.0" encoding="utf-8"?>
<!-- Colourful OS-picker preview — "battery" is TileAccents.Green in
     TileShell's own in-app catalogs. See widget_preview_weather.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1F9E57" />
            <corners android:radius="18dp" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_battery" />
</layer-list>
