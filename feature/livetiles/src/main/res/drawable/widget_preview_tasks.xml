<?xml version="1.0" encoding="utf-8"?>
<!-- Colourful OS-picker preview — "tasks" is TileAccents.Blue in TileShell's
     own in-app catalogs (CustomCardKind.TASKS.colorId). See widget_preview_steps.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2B78E4" />
            <corners android:radius="18dp" />
            <size android:width="96dp" android:height="96dp" />
        </shape>
    </item>
    <item
        android:width="52dp"
        android:height="52dp"
        android:gravity="center"
        android:drawable="@drawable/ic_widget_tasks" />
</layer-list>
