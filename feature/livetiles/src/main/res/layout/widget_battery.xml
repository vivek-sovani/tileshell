<?xml version="1.0" encoding="utf-8"?>
<!-- Full-size battery widget layout (>=180dp wide). Front is a big battery
     gauge (widget_icon — pushed at runtime as a real filled-bar bitmap, see
     WidgetBatteryVisual.kt, not a static outline glyph) beside percent/status
     — user-requested: "big battery image on one side with storage
     indication". Back mirrors BatteryBack (label/status) — see
     widget_weather.xml for the ViewFlipper/background-colour conventions this
     shares with every widget in this batch. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_background">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<ViewFlipper
    android:id="@+id/widget_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="6000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="64dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_widget_battery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/widget_back_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="battery"
            android:textSize="22sp"
            android:textColor="#FFFFFFFF" />

        <TextView
            android:id="@+id/widget_back_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>

</ViewFlipper>

    <ImageView
        android:id="@+id/widget_settings"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:padding="2dp"
        android:src="@drawable/ic_widget_settings" />

</FrameLayout>
