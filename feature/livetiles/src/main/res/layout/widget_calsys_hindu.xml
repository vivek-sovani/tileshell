<?xml version="1.0" encoding="utf-8"?>
<!-- Full-size Hindu Panchang widget layout. Mirrors the in-app PanchangFace:
     front = devanagari script, back = english/transliterated — both with the
     same big real moon-phase crescent (see WidgetMoonPhaseVisual.kt, reused
     from the moon-phase widget) beside a vara/paksha·tithi·month/nakshatra/
     year text hierarchy, with the roman date as a trailing line on both
     faces (not a dedicated third page — matches the in-app tile exactly). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rounded_background">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

<ViewFlipper
    android:id="@+id/widget_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:autoStart="true"
    android:flipInterval="6000"
    android:inAnimation="@android:anim/fade_in"
    android:outAnimation="@android:anim/fade_out">

    <!-- Front: devanagari. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_widget_moonphase" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_vara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <!-- The tithi as a big number, like a calendar's day of month. -->
                <TextView
                    android:id="@+id/widget_tithi_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="38sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_paksha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#FFE2A200" />

                <TextView
                    android:id="@+id/widget_nakshatra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

                <TextView
                    android:id="@+id/widget_roman"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFFFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <!-- The day's highlighted tithi / festival (PanchangObservances); GONE
             on ordinary days. Front face only — the back never shows it. Sits under
             the gear, padded clear of it. -->
        <TextView
            android:id="@+id/widget_observance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#FFE2A200"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="34dp"
            android:paddingBottom="3dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FF3A2600"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Back (user-requested: no moon picture, text laid out better):
         ayana heading, a sun column and a moon column side by side, the
         Roman date at the bottom. widget_icon_back/vara/paksha/nakshatra
         stay (GONE at runtime) so the worker's view ids keep resolving. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_icon_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_back_ayana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

        <TextView android:id="@+id/widget_back_vara" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_back_paksha" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_back_nakshatra" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:id="@+id/widget_back_sun_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="सूर्य"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFE2A200" />

            <TextView
                android:id="@+id/widget_back_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
            <TextView
                android:id="@+id/widget_back_sunset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                android:id="@+id/widget_back_moon_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="चंद्र"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFE2A200" />

            <TextView
                android:id="@+id/widget_back_moonrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />
            <TextView
                android:id="@+id/widget_back_moonset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/widget_back_roman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF" />

    </LinearLayout>

</ViewFlipper>

    <ImageView
        android:id="@+id/widget_settings"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:padding="2dp"
        android:src="@drawable/ic_widget_settings" />

</FrameLayout>
