<?xml version="1.0" encoding="utf-8"?>
<!-- Task reminders: exact alarms, user-granted via "Alarms & reminders".
     No Play Console declaration (USE_EXACT_ALARM, which needs one, is not used).
     Merged into the debug/release build types only while
     tileshell.taskReminders=true in gradle.properties. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
