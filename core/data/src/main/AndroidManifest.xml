<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Task reminders: re-arm alarms after a reboot. Normal permission, no
         prompt, no Play declaration. SCHEDULE_EXACT_ALARM is declared in the
         app manifest behind the tileshell.taskReminders switch. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Clock hub: the buzz at the end of a timer step. A normal permission,
         granted at install, no Play declaration. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <receiver
            android:name="com.tileshell.core.data.clock.ClockSessionReceiver"
            android:exported="false" />
        <receiver
            android:name="com.tileshell.core.data.reminders.TaskReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.tileshell.core.data.reminders.TaskReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
